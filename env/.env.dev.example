TF_VAR_AWS_REGION=eu-central-2
TF_VAR_INSTANCE_TYPE=t2.micro
TF_VAR_DB_INSTANCE_CLASS=db.t3.micro

TF_VAR_DB_NAME=prestashop
TF_VAR_DB_USER=prestashop_admin
TF_VAR_DB_PASSWORD=change-me
