ANSIBLE_REDIS_PASSWORD=change-me
ANSIBLE_REGISTRY_USERNAME=gitlab+deploy-token-00000000
ANSIBLE_REGISTRY_PASSWORD=change-me
ANSIBLE_PRESTASHOP_IMAGE=registry.gitlab.com/school-hetic/2026-w2-greenleaf/prestashop:redis-1.0.0

# Terraform inputs
TF_VAR_AWS_ACCESS_KEY=change-me
TF_VAR_AWS_SECRET_KEY=change-me
